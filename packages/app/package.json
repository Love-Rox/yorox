{
  "name": "@yorox/app",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "cf-typegen": "wrangler types",
    "dev": "waku dev",
    "build": "waku build",
    "start": "wrangler dev",
    "deploy": "waku build && wrangler deploy",
    "typegen": "waku router typegen",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply yorox-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply yorox-db --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@yorox/ap": "workspace:*",
    "@yorox/slot-coordinator": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-server-dom-webpack": "~19.2.8",
    "waku": "1.0.0-beta.8",
    "wrangler": "^4.120.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "miniflare": "^4.20260721.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
