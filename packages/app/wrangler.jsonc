{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yorox",
  "main": "./src/waku.server",
  "routes": [
    {
      "pattern": "yorox.love-rox.cc",
      "custom_domain": true
    }
  ],
  // nodejs_als is required for Waku server-side request context
  "compatibility_flags": ["nodejs_als"],
  "compatibility_date": "2025-11-17",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/public",
    "html_handling": "drop-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yorox-db",
      "database_id": "6c3a1b3e-cad7-401c-9177-40609aed601a",
      "migrations_dir": "./drizzle/migrations"
    }
  ],
  "send_email": [
    {
      // Cloudflare Email Service(yorox.love-rox.cc は sending 有効化済み)
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@yorox.love-rox.cc"]
    }
  ],
  "vars": {
    "MAIL_TRANSPORT": "cloudflare",
    "MAIL_FROM": "Yorox <noreply@yorox.love-rox.cc>",
    // ファイルアップロード有効(R2)
    "FILE_UPLOADS": "1",
    "MAX_UPLOAD_MB": "5",
    "MAIL_RATE_PER_MINUTE": "10",
    "MAIL_RATE_PER_HOUR": "100"
  },
  "r2_buckets": [
    {
      // 資料・サムネイル等のファイルホスティング(インスタンス設定で有効化)
      "binding": "FILES",
      "bucket_name": "yorox-files"
    }
  ],
  "services": [
    {
      // 先着枠の定員直列化(packages/slot-coordinator の DO Worker)
      "binding": "SLOT_COORDINATOR",
      "service": "yorox-slot-coordinator"
    }
  ],
  "triggers": {
    // 抽選締切チェックと通知ディスパッチ(5分毎)
    "crons": ["*/5 * * * *"]
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "no_bundle": true
}
